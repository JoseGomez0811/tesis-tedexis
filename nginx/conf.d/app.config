server {
    listen 80;
    server_name localhost;

    # Configuración para Laravel API
    location /api {
        root /var/www/public;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Configuración para Google OAuth
    location /google-auth {
        root /var/www/public;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Configuración para archivos estáticos de Laravel
    location /storage {
        root /var/www/public;
        try_files $uri =404;
    }

    # Configuración PHP para Laravel
    location ~ \.php$ {
        root /var/www/public;
        include fastcgi_params;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }

    # Proxy para Angular frontend
    location / {
        proxy_pass http://angular:4200;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Configuración para archivos estáticos de Angular
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        proxy_pass http://angular:4200;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}



