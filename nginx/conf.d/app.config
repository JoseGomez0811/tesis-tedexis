# ===========================================
# HTTP Server - Redirect to HTTPS
# ===========================================
server {
    listen 80;
    server_name localhost;
    return 301 https://$host$request_uri;
}

# ===========================================
# HTTPS Server - Main Configuration
# ===========================================
server {
    listen 443 ssl;
    http2 on;
    server_name localhost;

    # SSL Configuration
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Root for Angular SPA
    root /usr/share/nginx/html;
    index index.html;

    # Buffer settings
    client_max_body_size 20M;

    # ===========================================
    # Security & CORS Headers (Simplificado)
    # ===========================================
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Access-Control-Allow-Origin "https://localhost" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept" always;
    add_header Access-Control-Allow-Credentials "true" always;

    # ===========================================
    # OPTIONS Preflight
    # ===========================================
    if ($request_method = OPTIONS) {
        return 204;
    }

    # ===========================================
    # Sanctum & Laravel API Routes
    # ===========================================
    location ~ ^/(sanctum|api|google-auth|test-mail) {
        root /var/www/public;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ===========================================
    # PHP Processing
    # ===========================================
    location ~ \.php$ {
        root /var/www/public;
        try_files $uri =404;
        
        include fastcgi_params;
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/public$fastcgi_script_name;

        # Aumentar buffers para evitar "upstream sent too big header"
        fastcgi_buffer_size 32k;
        fastcgi_buffers 8 32k;
        fastcgi_read_timeout 300;
    }

    # ===========================================
    # Static Assets Cache (DEBE IR ANTES del catch-all)
    # ===========================================
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|mp4|webm|mp3|pdf)$ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ===========================================
    # Angular SPA - Catch-all (DEBE IR AL FINAL)
    # ===========================================
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ @fallback;
    }

    # Fallback para rutas de Angular SPA
    location @fallback {
        root /usr/share/nginx/html;
        try_files /index.html =404;
    }

    # ===========================================
    # Block Hidden Files
    # ===========================================
    location ~ /\. {
        deny all;
    }
}